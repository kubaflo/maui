<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui.Controls.Sample.Issues.Issue30197"
    Title="TimePicker culture change">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                FontSize="20"
                Text="TimePicker runtime culture test" />
            <Label
                x:Name="CultureLabel"
                AutomationId="CultureLabel"
                Text="Current culture: en-US" />
            <Label
                Text="The default-format TimePicker below initially shows 1:05 PM. After changing to fr-FR it should immediately use a 24-hour format." />
            <TimePicker
                x:Name="CultureTimePicker"
                AutomationId="CultureTimePicker"
                Loaded="OnTimePickerLoaded"
                Time="13:05:00" />
            <Button
                AutomationId="ChangeCultureButton"
                Clicked="OnChangeCultureClicked"
                Text="Change culture to fr-FR" />
            <Label
                x:Name="LoadedStatusLabel"
                AutomationId="LoadedStatusLabel"
                Text="TimePicker not loaded" />
            <Label
                x:Name="TransitionStatusLabel"
                AutomationId="TransitionStatusLabel"
                Text="not-started" />
            <Label
                x:Name="ExpectedValueLabel"
                AutomationId="ExpectedValueLabel" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

