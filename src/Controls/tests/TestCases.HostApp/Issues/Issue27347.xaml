<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample.Issues"
             x:Class="Maui.Controls.Sample.Issues.Issue27347"
             Title="Attachment list">
    <ContentPage.Resources>
        <local:Issue27347IsListNotNullOrNotEmptyConverter x:Key="IsListNotNullOrNotEmptyConverter" />
        <local:Issue27347IsMultiValueAllTrueConverter x:Key="IsMultiValueAllTrueConverter" />
    </ContentPage.Resources>

    <Grid Padding="24"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="16">
        <VerticalStackLayout Spacing="10">
            <Label Text="ObservableCollection MultiBinding"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Button AutomationId="ToggleDataButton"
                    Text="Toggle Data"
                    Clicked="OnToggleDataClicked" />
            <Button AutomationId="ToggleEditModeButton"
                    Text="Toggle Edit Mode"
                    Clicked="OnToggleEditModeClicked" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        AutomationId="AttachmentsView"
                        ItemsSource="{Binding Attachments}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label AutomationId="EmptyStateLabel"
                       Text="No attachments"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8"
                          ColumnDefinitions="*,Auto">
                        <Label Text="{Binding .}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                AutomationId="DeleteButton"
                                Text="Delete"
                                CommandParameter="{Binding .}"
                                Clicked="OnDeleteClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                AutomationId="AddButton"
                Text="Add"
                HorizontalOptions="End"
                VerticalOptions="End">
            <Button.IsVisible>
                <MultiBinding Converter="{StaticResource IsMultiValueAllTrueConverter}">
                    <Binding Path="Attachments"
                             Converter="{StaticResource IsListNotNullOrNotEmptyConverter}" />
                    <Binding Path="IsEditable" />
                </MultiBinding>
            </Button.IsVisible>
        </Button>

        <Label x:Name="CollectionCountLabel"
               Grid.Row="2"
               AutomationId="CollectionCount"
               Text="-1" />
    </Grid>
</ContentPage>

