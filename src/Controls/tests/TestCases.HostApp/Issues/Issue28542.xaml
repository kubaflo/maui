<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="Maui.Controls.Sample.Issues.Issue28542"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
	<Grid
		x:Name="RootLayout"
		Padding="16"
		RowDefinitions="Auto,Auto,Auto,*,Auto"
		RowSpacing="8"
		AutomationId="RootLayout">
		<Label
			Grid.Row="0"
			FontAttributes="Bold"
			FontSize="20"
			Text="CollectionView scrollbar sizing" />
		<Label
			x:Name="ReadyStatus"
			Grid.Row="1"
			AutomationId="ReadyStatus"
			Text="Preparing" />
		<Label
			x:Name="MeasurementStatus"
			Grid.Row="2"
			AutomationId="MeasurementStatus"
			FontSize="8"
			LineBreakMode="NoWrap"
			Text="Preparing measurements" />
		<CollectionView
			x:Name="CalibrationCollection"
			Grid.Row="3"
			ItemsSource="{Binding CalibrationRows}">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid
						Padding="12"
						BackgroundColor="{Binding Color}"
						HeightRequest="{Binding Height}">
						<Label
							FontSize="18"
							Text="{Binding Text}"
							VerticalOptions="Center" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<CollectionView
			x:Name="VariableHeightCollection"
			Grid.Row="3"
			AutomationId="VariableHeightCollection"
			IsVisible="False"
			ItemsSource="{Binding Rows}"
			Scrolled="OnCollectionScrolled">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid
						Padding="12"
						BackgroundColor="{Binding Color}"
						HeightRequest="{Binding Height}">
						<Label
							FontSize="18"
							Text="{Binding Text}"
							VerticalOptions="Center" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<Button
			Grid.Row="4"
			AutomationId="CheckScrollbarButton"
			Clicked="OnCheckClicked"
			Text="Check scrollbar size" />
	</Grid>
</ContentPage>

