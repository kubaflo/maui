<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample.Issues"
             x:Class="Maui.Controls.Sample.Issues.Issue33732"
             Title="Scroll to object">
    <Grid Margin="20"
          RowDefinitions="Auto,Auto,Auto,Auto,*">
        <ScrollView Grid.Row="0"
                    HeightRequest="60">
            <StackLayout>
                <Label Text="1.Ensure that the Proboscis Monkey item scrolls into view by clicking the 'Scroll to Proboscis Monkey' button." />
                <Label Text="2.Verify that the selected item should be scrolled until it's visible in the view when ScrollToPosition is set to MakeVisible." />
                <Label Text="3.Verify that the selected item should be scrolled to the start of the view when ScrollToPosition is set to Start." />
                <Label Text="4.Verify that the selected item should be scrolled to the center of the view when ScrollToPosition is set to Center." />
                <Label Text="5.Verify that the selected item should be scrolled to the end of the view when ScrollToPosition is set to End." />
                <Label Text="6.Check if the Animate scroll toggles the animation of the scroll." />
            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="1"
                     Orientation="Horizontal"
                     HorizontalOptions="Center">
            <Label Text="ScrollToPosition: "
                   VerticalTextAlignment="Center" />
            <Picker x:Name="PositionPicker"
                    AutomationId="PositionPicker" />
        </StackLayout>

        <StackLayout Grid.Row="2"
                     Orientation="Horizontal"
                     HorizontalOptions="Center">
            <Label Text="Animate scroll: "
                   VerticalTextAlignment="Center" />
            <Switch x:Name="AnimateSwitch"
                    AutomationId="AnimateSwitch"
                    IsToggled="True" />
        </StackLayout>

        <Button Grid.Row="3"
                AutomationId="ScrollButton"
                Text="Scroll to Proboscis Monkey"
                Clicked="OnScrollButtonClicked" />

        <Label Grid.Row="0"
               x:Name="ConfigurationLabel"
               AutomationId="ConfigurationLabel"
               HorizontalOptions="End"
               VerticalOptions="Start" />
        <Label Grid.Row="0"
               x:Name="RequestCountLabel"
               AutomationId="RequestCountLabel"
               HorizontalOptions="End"
               VerticalOptions="End"
               Text="Requests=0" />

        <CollectionView Grid.Row="4"
                        x:Name="MonkeyCollection"
                        AutomationId="MonkeyCollection"
                        ItemsSource="{Binding Monkeys}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Issue33732MonkeyItem">
                    <Grid Padding="10"
                          Loaded="OnMonkeyRowLoaded">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.RowSpan="2"
                               Source="{Binding ImageSource}"
                               Aspect="AspectFill"
                               HeightRequest="60"
                               WidthRequest="60" />
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontAttributes="Bold" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Location}"
                               FontAttributes="Italic"
                               VerticalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

