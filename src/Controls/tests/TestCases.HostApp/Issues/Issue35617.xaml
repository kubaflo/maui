<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 x:Class="Maui.Controls.Sample.Issues.Issue35617">
	<Grid Margin="20"
		  RowDefinitions="Auto,Auto,*">
		<StackLayout Grid.Row="0">
			<Label Text="1. The test passes if you can see the string 'A Label under the CollectionView'." />
			<Label Text="2. Quickly click Add multiple times; every new item should render immediately." />
			<Button x:Name="ResetButton"
					AutomationId="ResetButton"
					Text="Reset"
					Clicked="ResetButton_Clicked"
					HorizontalOptions="Start" />
			<Label x:Name="ResultLabel"
				   AutomationId="ResultLabel" />
		</StackLayout>
		<Button x:Name="AddButton"
				Grid.Row="1"
				AutomationId="AddButton"
				Text="Add"
				Clicked="AddButton_Clicked"
				HorizontalOptions="Start"
				VerticalOptions="Start" />
		<Grid Grid.Row="2"
			  RowDefinitions="Auto,*">
			<CollectionView x:Name="ItemsCollectionView"
							AutomationId="ItemsCollectionView"
							BackgroundColor="LightSalmon"
							HeightRequest="50"
							Loaded="ItemsCollectionView_Loaded">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Horizontal" />
				</CollectionView.ItemsLayout>
			</CollectionView>
			<Label Grid.Row="1"
				   Text="A Label under the CollectionView" />
		</Grid>
	</Grid>
</ContentPage>
