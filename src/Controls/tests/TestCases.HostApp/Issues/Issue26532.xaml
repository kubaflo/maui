<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="Maui.Controls.Sample.Issues.Issue26532">
	<VerticalStackLayout Padding="24" Spacing="16">
		<Label Text="Select the second answer, then change the question." />
		<Picker
			AutomationId="AnswerPicker"
			ItemsSource="{Binding Answers}"
			SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}" />
		<Label
			x:Name="OriginalSelectionLabel"
			AutomationId="OriginalSelection"
			Text="Original item selected answer: none" />
		<Button
			AutomationId="NextQuestionButton"
			Text="Next question"
			Clicked="NextButton_Clicked" />
		<Label
			x:Name="TransitionStatusLabel"
			AutomationId="TransitionStatus"
			Text="BindingContext transition pending" />
		<Label
			x:Name="ReplacementAnswerCountLabel"
			AutomationId="ReplacementAnswerCount"
			Text="Replacement answer count: pending" />
	</VerticalStackLayout>
</ContentPage>

