<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="Maui.Controls.Sample.Issues.Issue26532">
	<VerticalStackLayout
		Padding="24"
		Spacing="16">
		<Label
			Text="Picker BindingContext reproduction"
			FontSize="20" />
		<Picker
			AutomationId="AnswerPicker"
			Title="Select an answer"
			ItemsSource="{Binding Answers}"
			SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}" />
		<Label
			x:Name="OriginalSelectionLabel"
			AutomationId="OriginalSelectionLabel"
			Text="Original selection: &lt;null&gt;" />
		<Label
			x:Name="DefectStatusLabel"
			AutomationId="DefectStatusLabel"
			Text="No defect observed" />
		<Label
			x:Name="ContextStateLabel"
			AutomationId="ContextStateLabel"
			Text="First question active" />
		<Button
			x:Name="NextButton"
			AutomationId="NextButton"
			Text="Next"
			Clicked="OnNextClicked" />
	</VerticalStackLayout>
</ContentPage>

