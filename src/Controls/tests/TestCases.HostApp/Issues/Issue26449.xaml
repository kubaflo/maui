<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="Maui.Controls.Sample.Issues.Issue26449">
	<Grid
		Padding="12"
		RowDefinitions="Auto,Auto,*"
		RowSpacing="8">
		<Label
			Text="Nested CollectionView scrolling"
			FontAttributes="Bold"
			FontSize="20" />
		<Label
			x:Name="ScrollTelemetryLabel"
			Grid.Row="1"
			AutomationId="ScrollTelemetry"
			Text="Source=Unset; Sequence=-1; InnerEvents=0; OuterEvents=0; InnerDelta=0; OuterDelta=0" />
		<CollectionView
			x:Name="OuterCollection"
			Grid.Row="2"
			AutomationId="OuterCollection"
			Scrolled="OnOuterCollectionScrolled">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<VerticalStackLayout
						Padding="8"
						Spacing="6">
						<Label
							Text="{Binding Title}"
							FontAttributes="Bold" />
						<CollectionView
							HeightRequest="260"
							ItemsSource="{Binding Items}"
							Scrolled="OnInnerCollectionScrolled">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid
										Padding="8"
										HeightRequest="52">
										<Label
											Text="{Binding}"
											VerticalOptions="Center" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</VerticalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>

