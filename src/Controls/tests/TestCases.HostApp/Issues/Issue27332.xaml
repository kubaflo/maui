<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Controls.Sample.Issues.Issue27332"
             Title="Header and Footer (Add Clear)">
    <Grid Margin="20"
          RowDefinitions="Auto,Auto,*">
        <StackLayout Grid.Row="0">
            <Label x:Name="ResetStatusLabel"
                   AutomationId="ResetStatusLabel"
                   Text="Reset:-1" />
        </StackLayout>
        <Button Grid.Row="1"
                AutomationId="AddItemsButton"
                Text="Add 2 Items"
                FontAttributes="Bold"
                SemanticProperties.Hint="Counts the number of times you click"
                Margin="20"
                HorizontalOptions="Start"
                Clicked="OnAddItemsClicked" />
        <Label Grid.Row="1"
               AutomationId="ResultLabel"
               Text="NO BUG:"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <Button Grid.Row="1"
                AutomationId="ClearItemsButton"
                Text="Clear All Items"
                Margin="20"
                HorizontalOptions="End"
                FontAttributes="Bold"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnClearItemsClicked" />
        <CollectionView Grid.Row="2"
                        x:Name="IssueCollectionView"
                        AutomationId="IssueCollectionView"
                        VerticalOptions="FillAndExpand">
            <CollectionView.Header>
                <StackLayout BackgroundColor="LightGray">
                    <Label AutomationId="HeaderLabel"
                           Margin="10,0,0,0"
                           Text="Header"
                           FontSize="12"
                           FontAttributes="Bold" />
                </StackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentView>
                            <Frame Margin="2,6"
                                   CornerRadius="20">
                                <Label Text="{Binding .}"
                                       FontSize="Title" />
                            </Frame>
                        </ContentView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <StackLayout BackgroundColor="LightGray">
                    <Label AutomationId="FooterLabel"
                           Margin="10,0,0,0"
                           Text="Footer"
                           FontSize="12"
                           FontAttributes="Bold" />
                </StackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>

